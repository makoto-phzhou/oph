{
  "manifest_version": 3,
  "name": "OaiQ Pixel Helper",
  "version": "0.1.0",
  "description": "Detect and troubleshoot the OpenAI Ads Measurement Pixel (oaiq) on any page.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OaiQ Pixel Helper — no pixel detected",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "32": "icons/inactive-32.png"
    }
  },
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "permissions": ["webNavigation"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject-detect.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
